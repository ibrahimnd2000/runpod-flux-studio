{
  "info": {
    "name": "Runpod FLUX + LTX endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set RUNPOD_API_KEY, ENDPOINT_ID (FLUX image endpoint) and, for video, VIDEO_ENDPOINT_ID and IMAGE_URL (an https URL of a JPEG/PNG, e.g. a FLUX output). Image: /runsync returns the image inline (base64 PNG in output.images[0]); /run + /status is the async pattern. Video: always /run + /status (clips take minutes on a cold worker); output.video is a base64 MP4 (with audio on the LTX-2.5 endpoint; Wan 2.2 is silent). VIDEO_ENDPOINT_ID can be either video endpoint."
  },
  "variable": [
    {
      "key": "RUNPOD_API_KEY",
      "value": ""
    },
    {
      "key": "ENDPOINT_ID",
      "value": ""
    },
    {
      "key": "JOB_ID",
      "value": ""
    },
    {
      "key": "VIDEO_ENDPOINT_ID",
      "value": ""
    },
    {
      "key": "IMAGE_URL",
      "value": ""
    },
    {
      "key": "VIDEO_JOB_ID",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Run sync (prompt -> image)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/runsync",
        "description": "Waits for the result. The response includes delayTime (queue + cold start) and executionTime in ms.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"A studio product photo of a ceramic coffee mug on a walnut table, soft morning light, shallow depth of field\",\n    \"width\": 1024,\n    \"height\": 1024,\n    \"num_inference_steps\": 28,\n    \"guidance_scale\": 3.5,\n    \"seed\": 42\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('completed', () => pm.expect(r.status).to.eql('COMPLETED'));",
              "pm.test('has image + seed', () => { pm.expect(r.output.images).to.have.lengthOf.at.least(1); pm.expect(r.output.seed).to.be.a('number'); });",
              "if (r.output && r.output.images) { pm.visualizer.set('<img style=\"max-width:100%\" src=\"data:image/png;base64,{{img}}\"/><p>seed {{seed}} | delay {{d}} ms | exec {{e}} ms</p>', {img: r.output.images[0], seed: r.output.seed, d: r.delayTime, e: r.executionTime}); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Run async",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/run",
        "description": "Queues the job and returns its id immediately.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"A studio product photo of a ceramic coffee mug on a walnut table, soft morning light, shallow depth of field\",\n    \"width\": 1024,\n    \"height\": 1024,\n    \"num_inference_steps\": 28,\n    \"guidance_scale\": 3.5,\n    \"seed\": 42\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.collectionVariables.set('JOB_ID', r.id);",
              "pm.test('queued', () => pm.expect(r.id).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          }
        ],
        "url": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/status/{{JOB_ID}}",
        "description": "Poll until status is COMPLETED or FAILED. Async results are kept for 30 minutes."
      }
    },
    {
      "name": "Bad input (expect FAILED)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/runsync",
        "description": "Shows validation: the handler returns {error}, which Runpod reports as status FAILED.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"input\": {\n    \"prompt\": \"\",\n    \"width\": 512\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('validation error', () => { pm.expect(r.status).to.eql('FAILED'); pm.expect(r.error).to.include('prompt'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{RUNPOD_API_KEY}}"
          }
        ],
        "url": "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/health",
        "description": "Worker counts (idle/running/initializing) and job counts."
      }
    },
    {
      "name": "Video (Wan 2.2 or LTX-2.5)",
      "item": [
        {
          "name": "Animate: run async",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('VIDEO_JOB_ID', r.id);",
                  "pm.test('queued', () => pm.expect(r.id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{RUNPOD_API_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://api.runpod.ai/v2/{{VIDEO_ENDPOINT_ID}}/run",
            "description": "Image (https URL, data URI or base64) + motion prompt -> MP4. 540p, 49 frames \u2248 2 s at 24 fps.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"image\": \"{{IMAGE_URL}}\",\n    \"prompt\": \"Slow cinematic camera push-in toward the product, soft light shifting\",\n    \"resolution\": \"540p\",\n    \"num_frames\": 49,\n    \"audio\": true,\n    \"seed\": 42\n  }\n}"
            }
          }
        },
        {
          "name": "Animate: status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.status === 'COMPLETED' && r.output && r.output.video) {",
                  "  pm.visualizer.set('<video controls autoplay style=\"max-width:100%\" src=\"data:video/mp4;base64,{{v}}\"></video><p>{{w}} \u00b7 exec {{e}} ms \u00b7 {{b}} bytes</p>', {v: r.output.video, w: (r.output.worker||{}).gpu, e: r.executionTime, b: r.output.bytes});",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{RUNPOD_API_KEY}}"
              }
            ],
            "url": "https://api.runpod.ai/v2/{{VIDEO_ENDPOINT_ID}}/status/{{VIDEO_JOB_ID}}",
            "description": "IN_QUEUE -> IN_PROGRESS (output = {step, total_steps}) -> COMPLETED. Visualize tab plays the clip."
          }
        },
        {
          "name": "Animate: bad input (expect FAILED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{RUNPOD_API_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://api.runpod.ai/v2/{{VIDEO_ENDPOINT_ID}}/runsync",
            "description": "Missing image: the handler returns {error}, reported as FAILED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"prompt\": \"push in\"\n  }\n}"
            }
          }
        },
        {
          "name": "Video health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{RUNPOD_API_KEY}}"
              }
            ],
            "url": "https://api.runpod.ai/v2/{{VIDEO_ENDPOINT_ID}}/health"
          }
        }
      ]
    }
  ]
}
