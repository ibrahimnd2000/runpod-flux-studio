# Copy to .env and fill in. Never commit .env.

# Runpod (used by bench/, scripts/ and the web app's server-side API routes)
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=

# Hugging Face token with access to black-forest-labs/FLUX.1-dev (build-time only, passed as a BuildKit secret)
HF_TOKEN=

# Container registry for scripts/build_and_push.sh
REGISTRY=docker.io
REGISTRY_USER=
IMAGE_TAG=v0.1.0

# Worker settings (set as endpoint env vars on Runpod)
MODEL_PRECISION=bf16
MOCK_PIPELINE=0

# Optional S3-compatible storage for output="url" and video results
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=

# Web app (app/): server-side only. On a Runpod pod, set these from Runpod Secrets.
DEMO_ACCESS_CODE=
DAILY_JOB_CAP=100
RATE_LIMIT_PER_10_MIN=12
BULK_MAX=8
VIDEO_DAILY_CAP=20
VIDEO_MAX_FRAMES=121
MAX_SIDE=1024
MAX_STEPS=28
DATA_DIR=

# --- Orchestration (Pipelines / Agent / Battleground) -----------------------
# Video endpoint for Wan 2.2 (scripts/deploy_video_wan.sh)
RUNPOD_WAN_ENDPOINT_ID=
# Open-model agents on a Runpod vLLM endpoint (scripts/deploy_llm.sh)
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LLM_MODEL=Qwen/Qwen3-8B
# Claude for agents, pipeline LLM steps and the battle judge (never commit a real key)
ANTHROPIC_API_KEY=
# Per-run ceilings and caps (defaults shown)
AGENT_MAX_USD_PER_RUN=1
AGENT_DAILY_RUNS=40
AGENT_MAX_ACTIVE_RUNS=4
