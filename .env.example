# Copy to .env and fill in. Never commit .env.

# Runpod (used by bench/, scripts/ and the web app's server-side API routes)
RUNPOD_API_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=

# Hugging Face token with access to black-forest-labs/FLUX.1-dev (build-time only, passed as a BuildKit secret)
HF_TOKEN=

# Container registry for scripts/build_and_push.sh
REGISTRY=docker.io
REGISTRY_USER=
IMAGE_TAG=v0.1.0

# Worker settings (set as endpoint env vars on Runpod)
MODEL_PRECISION=bf16
MOCK_PIPELINE=0

# Optional S3-compatible storage for output="url" and video results
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=

# Web app (app/): server-side only. On a Runpod pod, set these from Runpod Secrets.
DEMO_ACCESS_CODE=
DAILY_JOB_CAP=100
RATE_LIMIT_PER_10_MIN=12
BULK_MAX=8
MAX_SIDE=1024
MAX_STEPS=28
DATA_DIR=
